# Main Stack Environment Variables Template
# Copy this file to '.env' and populate your local credentials.
# DO NOT commit the actual '.env' file to GitHub.

# Database Engine Configuration
DB_USER=postgres_admin
DB_PASSWORD=your_password_here
DB_NAME=leads_pipeline
DB_HOST=db
DB_PORT=5433

# API Core Backend Configuration
PORT=5000

# Networking Topology Routing
FRONTEND_URL=http://frontend